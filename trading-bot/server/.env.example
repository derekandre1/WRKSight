# --- Core ---
PORT=8787
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_trading_bot

# --- Decision engine (Claude) ---
# Without a key, a deterministic stub scores candidates so the pipeline still runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- TradingView webhook ---
# Set the SAME value in your TradingView alert payload ("secret" field or X-Webhook-Secret header).
TRADINGVIEW_WEBHOOK_SECRET=

# --- Broker adapter: SIM | PAPER | LIVE ---
# Starts in SIM. Never set LIVE until you mean it.
BROKER_ADAPTER=SIM

# Alpaca paper sandbox (only needed for PAPER)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Robinhood agentic MCP (only needed for LIVE)
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Sentinel market-data feed ---
# Optional Finnhub key for clean price + news JSON (https://finnhub.io, free tier).
# Without it, the sentinel falls back to keyless Yahoo Finance.
FINNHUB_API_KEY=
SENTINEL_ENABLED=true
SENTINEL_NEWS=true
# Intraday move (fraction) that flags an urgent candidate. 0.03 = 3%.
SENTINEL_MOVE_PCT=0.03
# Min time between sentinel triggers for the same symbol (ms).
SENTINEL_RETRIGGER_MS=1800000

# --- Risk gate (Moderate defaults) ---
MAX_EXPOSURE_PCT=0.5
MAX_TRADE_PCT=0.1
DAILY_LOSS_LIMIT_PCT=0.05
CONVICTION_THRESHOLD=0.65
TRADE_COOLDOWN_MS=900000

# --- Simulation starting state ---
SIM_STARTING_CASH=100000

# --- Watchlist (comma separated) ---
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL
